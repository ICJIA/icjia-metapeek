# Supabase project "metapeek" (ref yncuzxstzcnfhmfciwqz) — rate-limit counter store.
# Copy to .env for local dev; set the same two vars in Netlify:
#   Site configuration → Environment variables (all deploy contexts).
# Without these, rate limiting falls back to a per-instance in-memory store.
SUPABASE_URL=https://yncuzxstzcnfhmfciwqz.supabase.co
# Project Settings → API Keys → secret key (sb_secret_…). NEVER the
# publishable/anon key, and never commit the real value.
SUPABASE_SECRET_KEY=

# Optional: bearer token that bypasses rate limiting and (when set) is
# required by the API routes. Leave unset for the public keyless API.
# METAPEEK_API_KEY=
