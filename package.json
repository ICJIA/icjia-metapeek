{
  "name": "icjia-metapeek",
  "version": "0.14.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "start-dev-server": "./scripts/start-dev-server.sh",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test": "vitest run --reporter=verbose",
    "test:all": "vitest run --reporter=verbose && playwright test --reporter=list",
    "test:unit": "vitest run",
    "test:security": "vitest run tests/security",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:accessibility": "playwright test --reporter=list",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "nuxt cleanup",
    "audit": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "@nuxt/ui": "^4.4.0",
    "@nuxtjs/seo": "^3.4.0",
    "@sparticuz/chromium": "^143.0.4",
    "@vueuse/core": "^14.2.0",
    "@vueuse/nuxt": "^14.2.0",
    "cheerio": "^1.2.0",
    "nuxt": "^4.4.6",
    "puppeteer-core": "^24.40.0",
    "vue": "^3.5.27"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.69",
    "@nuxt/eslint": "^1.13.0",
    "@nuxt/test-utils": "^3.14.3",
    "@playwright/test": "^1.49.0",
    "@vitest/coverage-v8": "^3.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.2",
    "happy-dom": "^20.0.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "undici@<7.24.0": ">=7.24.0",
      "h3@<1.15.6": ">=1.15.6",
      "fast-xml-parser@<5.5.6": ">=5.5.6",
      "fast-xml-builder@<1.1.7": ">=1.1.7"
    },
    "auditConfig": {
      "ignoreCves": []
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@sparticuz/chromium",
      "esbuild",
      "puppeteer-core",
      "sharp",
      "vue-demi"
    ]
  }
}
