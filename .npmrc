# pnpm config — required for Nuxt 4 compatibility (Netlify-documented).
# https://docs.netlify.com/build/configure-builds/manage-dependencies
#
# Nuxt's modules (especially @nuxtjs/seo, unhead) expect dependencies
# hoisted to the root node_modules. Strict pnpm isolation creates
# duplicate copies (e.g. @unhead/vue@2.1.10 vs 2.1.15) which break
# SSR/prerender. shamefully-hoist deduplicates by lifting all deps to
# the top level — same shape as yarn/npm.
shamefully-hoist=true

# Mirror Netlify's CI install behavior locally so what builds locally
# is what builds on Netlify.
strict-peer-dependencies=false
auto-install-peers=true
